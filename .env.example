# ── Chain (public) ───────────────────────────────────────────────────────────
# Unset = PREVIEW: campaigns list without escrow, payouts are computed but not
# claimable, and every screen says so. Set all three to go live.
NEXT_PUBLIC_CLIPR_LIVE=false
NEXT_PUBLIC_CLIPR_TOKEN_ADDRESS=
NEXT_PUBLIC_CLIPR_ESCROW_ADDRESS=

# Robinhood Chain defaults live in src/lib/chain.ts; override to point at
# another network (a local Hardhat node is 31337 / http://127.0.0.1:8545).
# NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
# NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com

# ── Economics (public) — must match the deployed escrow ──────────────────────
NEXT_PUBLIC_CLIPR_FEE_BPS=500
NEXT_PUBLIC_CLIPR_TRACKING_DAYS=7
# Optional USD reference price for the "≈ $" hints in the launch wizard.
# Unset = no hints; nothing on the site invents a price.
# NEXT_PUBLIC_CLIPR_USD=

# ── Site (public) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://clipr.xyz
NEXT_PUBLIC_CLIPR_X=cliprxyz

# ── Server secrets ───────────────────────────────────────────────────────────
# HMAC key for session cookies. Unset = random per process (sessions die on
# restart), with a warning in the log. REQUIRED on Vercel or any host that
# runs more than one instance — otherwise sign-ins flicker between instances.
SESSION_SECRET=

# The voucher signer: the private key whose address was passed to ClipEscrow
# as `signer`. Anything it signs within a budget is payable. Keep it off the
# web server in production (KMS / signing service) — this is the trust root.
SETTLEMENT_SIGNER_KEY=

# Comma-separated wallets allowed on /ops (verify views, settle, activate).
# Unset in preview = every signed-in wallet is ops; unset when live = nobody.
OPS_ADDRESSES=

# YouTube Data API v3 key: the only automated view tracker. TikTok, Instagram
# and X counts are entered by hand on /ops and recorded as "manual".
YOUTUBE_API_KEY=

# SQLite file (default data/clipr.db). Created and seeded on first run;
# CLIPR_SKIP_SEED=true starts empty. On a read-only host (Vercel) the file
# falls back to /tmp and is EPHEMERAL — point this at a mounted volume for
# anything that must survive a restart.
# CLIPR_DB_PATH=
# CLIPR_SKIP_SEED=false
